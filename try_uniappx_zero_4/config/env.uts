export type AppEnvironment = 'development' | 'sit' | 'production'

let appEnvironment: AppEnvironment = 'production'
let apiBaseUrl = 'https://api.example.com'


// apiBaseUrl = 'http://localhost:7110/dev-api'

// #ifdef APP_ENV_DEV
appEnvironment = 'development'
apiBaseUrl = 'http://localhost:7110'
// #endif

// #ifdef APP_ENV_SIT
appEnvironment = 'sit'
apiBaseUrl = 'https://sit-api.example.com'
// #endif

export const ENV = {
  name: appEnvironment,
  baseURL: apiBaseUrl
}
