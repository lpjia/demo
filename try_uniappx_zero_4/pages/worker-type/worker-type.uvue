<template>
	<scroll-view class="page" scroll-y>
		<screen-header :title="bulName" subtitle="工种" />
		<view class="list">
			<view v-for="(workerType, i) in workerTypes" :key="workerType.id" class="worker-card"
				@click="openWorkItems(workerType)">
				<view class="worker-main">
					<view class="index-box">
						<text class="index-text">{{ i + 1 }}</text>
					</view>
					<text class="worker-name">{{ workerType.name }}</text>
					<text class="worker-progress">{{ workerType.progress }}%</text>
					<status-badge :status="CONSTRUCTION_STATUS[workerType.status]" />
				</view>
				<text class="forward">›</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	// import { WORKER_TYPES } from "../../common/data.uts";
	// import { WORKER_TYPE_LIST } from './worker_type_list.uts'
	import { WorkerType } from "@/type/index.uts";
	import { getWorkerTypesById } from "@/api/index.uts";
	import { CONSTRUCTION_STATUS } from "@/utils/const.uts";

	const bulName = ref("");
	const floorId = ref<number>(null);
	const workerTypes = ref([]);

	onLoad((options) => {
		bulName.value = decodeURIComponent(options.bulName);
		floorId.value = options.floorId;

		getWorkerTypesById(floorId.value).then((list : any[]) => (workerTypes.value = list));
	});

	function openWorkItems(workerType : WorkerType) {
		const bulwName = `${bulName.value} · ${workerType.name}`

		uni.navigateTo({
			url: `/pages/work-items/work-items?bulwName=${encodeURIComponent(bulwName)}&workerTypeId=${workerType.id}`
		});
	}
</script>

<style scoped lang="scss">
	@use "@/styles/_color.scss" as colorScss;

	.page {
		flex: 1;
		background-color: colorScss.$color-surface;
	}

	.list {
		padding: 32rpx;
	}

	.worker-card {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 24rpx;
		padding: 28rpx 30rpx;
		background-color: colorScss.$color-bg;
		border: 1px solid colorScss.$color-border;
		border-radius: 32rpx;
	}

	.worker-main {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.index-box {
		width: 80rpx;
		height: 80rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		background-color: colorScss.$color-surface-alt;
		border: 1px solid colorScss.$color-border;
		border-radius: 22rpx;
	}

	.index-text {
		color: colorScss.$color-text-secondary;
		font-size: 28rpx;
		font-weight: 700;
	}

	.worker-name {
		margin-left: 22rpx;
		color: colorScss.$color-text;
		font-size: 28rpx;
		font-weight: 600;
	}

	.worker-progress {
		margin: 0 22rpx;
		color: colorScss.$color-text;
		font-size: 28rpx;
		font-weight: 600;
	}
</style>
