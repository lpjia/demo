<template>
	<scroll-view class="page" scroll-y>
		<view class="topbar">
			<text class="eyebrow">工地管理</text>
			<text class="page-title">{{ projectName }}</text>
		</view>
		<view class="content">
			<view class="progress-card" @click="openBuildings">
				<view>
					<text class="meta-label">总体施工进度</text>
					<text class="progress-value">{{ progress }}%</text>
					<text class="progress-link">点击查看楼栋详情 →</text>
				</view>
				<view class="progress-ring" :style="ringStyle">
					<view class="progress-ring-inner">
						<image class="ring-home" src="@/static/overview/progress-home.svg" />
					</view>
				</view>
			</view>

			<view class="stats-row">
				<view class="stat-card stat-green">
					<text class="stat-value green-text">{{ finishedCount }}</text>
					<text class="stat-label green-text">已完工</text>
				</view>
				<view class="stat-card stat-amber">
					<text class="stat-value amber-text">{{ workingCount }}</text>
					<text class="stat-label amber-text">施工中</text>
				</view>
				<view class="stat-card stat-slate">
					<text class="stat-value slate-text">{{ pendingCount }}</text>
					<text class="stat-label slate-text">待施工</text>
				</view>
			</view>

			<text class="section-title">最近上报记录</text>
			<view v-for="(record, index) in RECENT_RECORDS" :key="index" class="record-card">
				<view class="record-top">
					<view class="record-copy">
						<text class="record-title">{{ record.building }} · {{ record.floor }}</text>
						<text class="record-type">{{ record.type }}</text>
					</view>
					<status-badge :status="record.status" />
				</view>
				<text class="record-time">{{ record.time }}</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getProjectById } from "@/api/index.uts";
	import { RECENT_RECORDS } from "@/common/data.uts";
	import { getStorage } from "@/utils/common.uts";
	// import { PROJECT } from './project.uts'

	const projectName = ref('')
	const progress = ref(0)
	const finishedCount = ref(0)
	const workingCount = ref(0)
	const pendingCount = ref(0)

	getStorage('projectId')
		.then(getProjectById)
		.then((data : any) => {
			console.log(data, 100);
			projectName.value = data.name
			progress.value = data.progress
			finishedCount.value = data.finishedCount
			workingCount.value = data.workingCount
			pendingCount.value = data.pendingCount
		})

	const ringStyle = computed(() => {
		const value = Math.max(0, Math.min(100, progress.value));
		return (
			"background: conic-gradient(from 0deg, #F97316 0 " + value + "%, #EEF0F2 " + value + "% 100%);"
		);
	});

	function openBuildings() : void {
		uni.navigateTo({ url: "/pages/buildings/buildings" });
	}
</script>

