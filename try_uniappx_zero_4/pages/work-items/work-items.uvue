		color: colorScss.$color-text-secondary;
		font-size: 22rpx;
		font-weight: 700;
	}

	// .item-type {
	.item-name {
		margin-left: 16rpx;
		color: colorScss.$color-text;
		font-size: 32rpx;
		font-weight: 700;
	}

	.dot {
		margin: 0 12rpx;
		color: colorScss.$color-text-tertiary;
		font-size: 28rpx;
	}

	.item-area {
		color: colorScss.$color-text-secondary;
		font-size: 28rpx;
		font-weight: 500;
	}

