<template>
	<scroll-view class="page" scroll-y>
		<screen-header :title="bulwName" subtitle="施工项" />
		<view class="list">
			<view v-for="(item, i) in workItems" :key="item.id" class="item-card">
				<view class="item-top" @click="openDetail(item)">
					<view class="item-identity">
						<view class="small-index">
							<text class="small-index-text">{{ i + 1 }}</text>
						</view>
						<text class="item-name">{{ item.name}}</text>
						<!-- <text class="item-type">{{ item.type}}</text>
						<text class="dot">·</text>
						<text class="item-area">{{ item.area }}</text> -->
					</view>
					<view class="item-status">
						<status-badge :status="CONSTRUCTION_STATUS[item.status]" />
						<text class="forward">›</text>
					</view>
				</view>
				<view class="divider"></view>
				<view class="metrics">
					<view class="metric">
						<text class="metric-label">平方</text>
						<text class="metric-value">
							{{ item.sqm }}
							<text class="metric-unit">m²</text>
						</text>
					</view>
					<view class="metric-separator"></view>
					<view class="metric">
						<text class="metric-label">费用</text>
						<text class="metric-value orange-text">¥{{ item.cost }}</text>
					</view>
					<view class="metric-separator"></view>
					<view class="metric">
						<text class="metric-label">责任人</text>
						<text class="person-value">
							{{ item.workers.length === 0 ? "无" : item.workers[0].name }}
						</text>
					</view>
				</view>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	// import { INITIAL_ITEMS } from "../../common/data.uts";
	// import { selectWorkItem } from "../../common/store.uts";
	// import type { WorkItem } from "../../common/types.uts";
	import { setStorageSync } from "@/utils/common.uts";
	import { getWorkItemsById } from "@/api/index.uts";
	import { WorkItem } from "@/type/index.uts";
	import { CONSTRUCTION_STATUS } from "@/utils/const.uts";

	const bulwName = ref("");
	const workerTypeId = ref<number>(null);
	const workItems = ref([]);

	onLoad((options) => {
		bulwName.value = decodeURIComponent(options.bulwName);
		workerTypeId.value = options.workerTypeId;

		getWorkItemsById(workerTypeId.value).then((list : any[]) => (workItems.value = list));
	});

	function openDetail(item : WorkItem) {
		setStorageSync('workItem', item)

		uni.navigateTo({
			url: `/pages/work-item-detail/work-item-detail?bulwName=${encodeURIComponent(bulwName.value)}`
		});
	}
</script>

