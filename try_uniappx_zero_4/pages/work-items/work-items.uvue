		flex: 1;
		min-width: 0;
	}

	.small-index {
		width: 40rpx;
		height: 40rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		background-color: colorScss.$color-surface-alt;
		border-radius: 10rpx;
	}

