	}

	.metrics {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		padding: 22rpx 30rpx 26rpx;
	}

	.metric {
		flex: 1;
	}

	.metric-label {
		color: colorScss.$color-text-tertiary;
		font-size: 24rpx;
	}

	.metric-value {
		margin-top: 4rpx;
		color: colorScss.$color-text;
		font-size: 32rpx;
		font-weight: 700;
	}

	.metric-unit {
		margin-left: 4rpx;
		color: colorScss.$color-text-tertiary;
