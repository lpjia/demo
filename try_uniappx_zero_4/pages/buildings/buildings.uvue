		border-radius: 32rpx;
	}

	.card-main {
		flex: 1;
		display: flex;
		flex-direction: row;
		align-items: center;
	}

	.index-box {
		width: 88rpx;
		height: 88rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		background-color: colorScss.$color-surface-alt;
		border: 1px solid colorScss.$color-border;
		border-radius: 24rpx;
	}

	.index-text {
		color: colorScss.$color-text-secondary;
