<template>
	<scroll-view class="page" scroll-y>
		<screen-header title="楼栋单元" subtitle="" />
		<view class="list">
			<view v-for="(buildingUnit, i) in buildingUnitList" :key="buildingUnit.unitId" class="building-card"
				@click="openFloors(buildingUnit)">
				<view class="card-main">
					<view class="index-box">
						<text class="index-text">{{ i + 1 }}</text>
					</view>
					<view class="building-copy">
						<text class="building-name">
							{{ `${buildingUnit.buildingName} ${buildingUnit.unitName}` }}
						</text>
						<text class="building-meta">
							共 {{ buildingUnit.totalFloor }} 层，已完工 {{ buildingUnit.finishedFloor }} 层
						</text>
					</view>
				</view>
				<text class="forward">›</text>
			</view>
		</view>
	</scroll-view>
</template>

<script setup lang="uts">
	import { getBuildingUnitListByProjectId } from "@/api/index.uts";
	import { BuildingUnit } from "@/type/index.uts";
	import { getStorage } from "@/utils/common.uts";
	// import { BUILDING_UNIT_LIST } from './building_unit_list.uts'

	const buildingUnitList = ref([]);

	getStorage("projectId")
		.then(getBuildingUnitListByProjectId)
		.then((list : any) => {
			buildingUnitList.value = list;
		});

	function openFloors(buildingUnit : BuildingUnit) {
		const buName = `${buildingUnit.buildingName} ${buildingUnit.unitName}`
		uni.navigateTo({ url: `/pages/floors/floors?buName=${encodeURIComponent(buName)}&unitId=${buildingUnit.unitId}` });
	}
</script>

