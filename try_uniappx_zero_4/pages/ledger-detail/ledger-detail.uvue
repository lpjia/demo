  background-color: colorScss.$color-bg;
  border-top: 1px solid colorScss.$color-border;
  border-bottom: 1px solid colorScss.$color-border;
}
.section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.section-title {
  color: colorScss.$color-text;
  font-size: 28rpx;
  font-weight: 700;
}
.attachment-count {
  font-size: 24rpx;
  font-weight: 500;
}
.attachment-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin: -8rpx;
}
.attachment-item {
  width: 200rpx;
