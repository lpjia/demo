  padding: 12rpx 24rpx;
  border-width: 1px;
  border-style: solid;
  border-radius: 16rpx;
  --color-expense: #{colorScss.$color-expense};
  --color-green: #{colorScss.$color-green};
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}
