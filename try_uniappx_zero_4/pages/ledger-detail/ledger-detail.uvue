<template>
  <scroll-view class="page" scroll-y>
    <view class="detail-header" :style="{ borderBottom: `1px solid ${accentBorder}` }">
      <view>
        <text class="header-eyebrow" :style="{ color: accent }">收支记录</text>
        <text class="header-title">收支详情</text>
      </view>
      <view
        class="edit-button"
        :style="{ backgroundColor: accentLight, borderColor: accentBorder }"
        @click="showEditForm = true"
      >
        <uni-icons v-if="isExpense" type="compose" size="30rpx" color="var(--color-expense)" />
        <uni-icons v-else type="compose" size="30rpx" color="var(--color-green)" />
        <text class="edit-button-text" :style="{ color: accent }">修改</text>
      </view>
    </view>

    <view
      class="amount-banner"
      :style="{ backgroundColor: accentLight, borderColor: accentBorder }"
    >
      <view class="amount-icon" :style="{ borderColor: accentBorder }">
        <text :style="{ color: accent }">{{ isExpense ? "↓" : "↑" }}</text>
      </view>
      <view class="amount-copy">
        <text class="amount-label">{{ entry.label }}</text>
        <text class="amount-value" :style="{ color: accent }">
          {{ isExpense ? "-" : "+" }}¥{{ toMoney(entry.amount) }}
        </text>
      </view>
    </view>

    <view class="rows-section">
      <ledger-detail-row label="日期" :value="formatLongDate(entry.date)" value-color="#111827" />
      <ledger-detail-row label="类别" :value="isExpense ? '支出' : '收入'" :value-color="accent" />
      <ledger-detail-row label="金额" :value="`¥${toMoney(entry.amount)}`" :value-color="accent" />
      <ledger-detail-row
        label="转账渠道"
        :value="entry.channel.length !== 0 ? entry.channel : '未记录'"
        value-color="#111827"
      />
      <ledger-detail-row
        v-if="isExpense"
        label="支出用途"
        :value="entry.purpose.length !== 0 ? entry.purpose : '未记录'"
        value-color="#111827"
      />
      <view class="name-row">
        <text class="row-label">名称</text>
        <text :class="['name-value', entry.name.length == 0 ? 'muted-name' : '']">
          {{ entry.name.length !== 0 ? entry.name : "未填写" }}
        </text>
      </view>
    </view>

    <view class="attachments-section">
      <view class="section-header">
        <text class="section-title">附件</text>
        <text
          v-if="entry.attachments.length !== 0"
          class="attachment-count"
          :style="{ color: accent }"
        >
          {{ entry.attachments.length }} 张
        </text>
      </view>
      <view v-if="entry.attachments.length !== 0" class="attachment-grid">
        <view
          v-for="(attachment, index) in entry.attachments"
          :key="attachment.id"
          class="attachment-item"
          @click="previewAttachment(index)"
        >
          <image class="attachment-image" :src="attachment.url" mode="aspectFill" />
        </view>
      </view>
      <view v-else class="empty-attachments"><text class="empty-text">未上传附件</text></view>
    </view>

    <ledger-form-sheet
      v-if="showEditForm"
      mode="edit"
      :initial-entry="entry"
      @close="showEditForm = false"
      @save="saveEdit"
    />
  </scroll-view>
</template>

<script setup lang="uts">
import { INITIAL_LEDGER_ENTRIES } from "../../common/data.uts";
import { currentLedgerEntry, updateLedgerEntry } from "../../common/store.uts";
import { formatLongDate, toMoney } from "../../common/utils.uts";
import type { LedgerEntry } from "../../common/types.uts";

import { COLOR } from "@/utils/const.uts";

const entry = ref<LedgerEntry>(INITIAL_LEDGER_ENTRIES[0]);
const showEditForm = ref(false);
const isExpense = computed((): boolean => entry.value.type == "expense");
const accent = computed((): string => (isExpense.value ? COLOR.expense : COLOR.green));
const accentLight = computed((): string =>
  isExpense.value ? COLOR.expenseLight : COLOR.greenLight
);
const accentBorder = computed((): string =>
  isExpense.value ? COLOR.expenseBorder : COLOR.greenBorder
);

onLoad(() => {
  refreshEntry();
});
onShow(() => {
  refreshEntry();
});

function refreshEntry(): void {
  if (currentLedgerEntry.value != null) entry.value = currentLedgerEntry.value!;
}

function previewAttachment(index: number): void {
  const urls: string[] = [];
  entry.value.attachments.forEach((attachment) => {
    urls.push(attachment.url);
  });
  uni.previewImage({ urls: urls, current: index });
}

function saveEdit(updatedEntry: LedgerEntry): void {
  updateLedgerEntry(updatedEntry);
  entry.value = updatedEntry;
  showEditForm.value = false;
  uni.showToast({ title: "修改成功", icon: "success" });
}
</script>

