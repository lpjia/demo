  margin-left: 24rpx;
}
.amount-label {
  color: colorScss.$color-text-secondary;
  font-size: 28rpx;
  font-weight: 600;
}
.amount-value {
  margin-top: 4rpx;
  font-size: 44rpx;
  font-weight: 700;
}
.rows-section {
  margin-top: 24rpx;
  padding: 0 40rpx;
  background-color: colorScss.$color-bg;
  border-top: 1px solid colorScss.$color-border;
  border-bottom: 1px solid colorScss.$color-border;
}
.name-row {
  min-height: 112rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.row-label {
  color: colorScss.$color-text-tertiary;
  font-size: 24rpx;
  font-weight: 500;
}
.name-value {
  flex: 1;
