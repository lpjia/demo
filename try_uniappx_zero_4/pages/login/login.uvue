<template>
	<view class="page">
		<view class="brand-area">
			<view class="brand-icon">
				<image class="brand-symbol" src="@/static/login/home.svg" />
			</view>
			<view>
				<text class="brand-title">工地管理系统</text>
				<text class="brand-subtitle">登录您的账户以继续</text>
			</view>
		</view>
		<view class="form-area">
			<text class="form-label">手机号</text>
			<view class="input-shell">
				<image class="input-icon" src="@/static/login/phone.svg" />
				<input class="login-input" v-model="phone" type="number" maxlength="11" placeholder="请输入手机号" />
			</view>
			<text class="form-label">密码</text>
			<view class="input-shell">
				<image class="input-icon" src="@/static/login/lock.svg" />
				<input class="login-input" v-model="password" :password="!showPassword" placeholder="请输入密码" />
				<view class="password-toggle" @click="showPassword = !showPassword">
					<image class="input-icon" v-if="!showPassword" src="@/static/login/eye.svg" />
					<image class="input-icon" v-else src="@/static/login/close-eye.svg" />
