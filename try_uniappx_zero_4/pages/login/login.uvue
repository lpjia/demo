	</view>
</template>

<script setup lang="uts">
	import { setStorage } from "@/utils/common";

	const phone = ref("");
	const password = ref("");
	const showPassword = ref(false);

	function login() {
		/* 登录成功后, 保存token和工程id */
		setTimeout(() => {
			setStorage('projectId', 1);
			uni.switchTab({ url: "/pages/overview/overview" });
		});
	}
</script>
