{
  "name": "commodity_price_electron_desktop",
  "version": "0.1.9",
  "description": "",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64",
    "clean": "rimraf dist",
    "build:all": "npm-run-all clean dist"
  },
  "build": {
    "appId": "com.example.eggvue",
    "win": {
      "target": "nsis"
    },
    "files": [
      "electron/**",
      "frontend/dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "D:\\nvm\\v18.14.0\\node.exe",
        "to": "node.exe",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "npm-run-all": "^4.1.5",
    "wait-on": "^8.0.3"
  }
}