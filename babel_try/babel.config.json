{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "edge": "17",
          "firefox": "60",
          "chrome": "67",
          "safari": "11.1"
        },
        "useBuiltIns": "usage",
        "corejs": "3.47.0",
        "modules": false
      }
    ]
  ],
  "plugins": [
    "@babel/plugin-transform-optional-chaining"
  ]
}