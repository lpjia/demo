{
  "name": "goods_price_electron_nestjs",
  "version": "0.1.0",
  "author": "lpjia",
  "license": "",
  "description": "",
  "keywords": [],
  "main": "src/main.js",
  "scripts": {
    "dev": "pnpm start",
    "start": "electron .",
    "build": "electron-builder"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "big.js": "^7.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dayjs": "^1.11.18",
    "mysql2": "^3.15.1",
    "swagger-ui-express": "^5.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "volta": {
    "node": "18.20.8",
    "pnpm": "8.15.9"
  },
  "build": {
    "appId": "com.goods.app",
    "productName": "商品",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main.js",
      "backend/dist/**/*",
      "backend/.env.prod",
      "frontend/dist/**/*",
      "!**/*.ts",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true,
    "asarUnpack": [
      "**/backend/dist/**/*.node"
    ]
  }
}