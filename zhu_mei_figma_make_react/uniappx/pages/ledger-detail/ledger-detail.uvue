<!-- 为了迁移 React 收支详情页，保留明细、附件原生预览和编辑后回写全局记录的完整流程。 -->
<template>
	<scroll-view class="page" scroll-y>
		<view class="detail-header">
			<view class="back-button" @click="goBack"><text class="back-icon">‹</text><text class="back-text">返回</text></view>
			<view class="header-row">
				<view><text class="header-eyebrow" :style="{ color: accent }">收支记录</text><text class="header-title">收支详情</text></view>
				<view class="edit-button" :style="{ backgroundColor: accentLight, borderColor: accentBorder }" @click="showEditForm = true"><text class="edit-button-text" :style="{ color: accent }">✎ 修改</text></view>
			</view>
		</view>

		<view class="amount-banner" :style="{ backgroundColor: accentLight, borderColor: accentBorder }">
			<view class="amount-icon" :style="{ borderColor: accentBorder }"><text :style="{ color: accent }">{{ isExpense ? '↓' : '↑' }}</text></view>
			<view class="amount-copy"><text class="amount-label">{{ entry.label }}</text><text class="amount-value" :style="{ color: accent }">{{ isExpense ? '-' : '+' }}¥{{ toMoney(entry.amount) }}</text></view>
		</view>

		<view class="rows-section">
			<ledger-detail-row label="日期" :value="formatLongDate(entry.date)" value-color="#111827" />
			<ledger-detail-row label="类别" :value="isExpense ? '支出' : '收入'" :value-color="accent" />
			<ledger-detail-row label="金额" :value="`¥${toMoney(entry.amount)}`" :value-color="accent" />
			<ledger-detail-row label="转账渠道" :value="entry.channel.length > 0 ? entry.channel : '未记录'" value-color="#111827" />
			<ledger-detail-row v-if="isExpense" label="支出用途" :value="entry.purpose.length > 0 ? entry.purpose : '未记录'" value-color="#111827" />
			<view class="name-row"><text class="row-label">名称</text><text :class="['name-value', entry.name.length == 0 ? 'muted-name' : '']">{{ entry.name.length > 0 ? entry.name : '未填写' }}</text></view>
		</view>

		<view class="attachments-section">
			<view class="section-header"><text class="section-title">附件</text><text v-if="entry.attachments.length > 0" class="attachment-count" :style="{ color: accent }">{{ entry.attachments.length }} 张</text></view>
			<view v-if="entry.attachments.length > 0" class="attachment-grid">
				<view v-for="(attachment, index) in entry.attachments" :key="attachment.id" class="attachment-item" @click="previewAttachment(index)"><image class="attachment-image" :src="attachment.url" mode="aspectFill" /></view>
			</view>
			<view v-else class="empty-attachments"><text class="empty-text">未上传附件</text></view>
		</view>

		<ledger-form-sheet v-if="showEditForm" mode="edit" :initial-entry="entry" @close="showEditForm = false" @save="saveEdit" />
	</scroll-view>
</template>

<script setup lang="uts">
	import { INITIAL_LEDGER_ENTRIES } from '../../common/data.uts'
	import { currentLedgerEntry, updateLedgerEntry } from '../../common/store.uts'
	import { formatLongDate, toMoney } from '../../common/utils.uts'
	import type { LedgerEntry } from '../../common/types.uts'

	const entry = ref<LedgerEntry>(INITIAL_LEDGER_ENTRIES[0])
	const showEditForm = ref(false)
	const isExpense = computed((): boolean => entry.value.type == 'expense')
	const accent = computed((): string => isExpense.value ? '#E11D48' : '#16A34A')
	const accentLight = computed((): string => isExpense.value ? '#FFF1F2' : '#F0FDF4')
	const accentBorder = computed((): string => isExpense.value ? '#FECDD3' : '#BBF7D0')

	onLoad(() => { refreshEntry() })
	onShow(() => { refreshEntry() })

	function refreshEntry(): void {
		if (currentLedgerEntry.value != null) entry.value = currentLedgerEntry.value!
	}

	function goBack(): void { uni.navigateBack() }

	function previewAttachment(index: number): void {
		const urls: string[] = []
		entry.value.attachments.forEach((attachment) => { urls.push(attachment.url) })
		uni.previewImage({ urls: urls, current: index })
	}

	function saveEdit(updatedEntry: LedgerEntry): void {
		updateLedgerEntry(updatedEntry)
		entry.value = updatedEntry
		showEditForm.value = false
		uni.showToast({ title: '修改成功', icon: 'success' })
	}
</script>

<style>
	.page { flex: 1; background-color: #F8F9FB; }
	.detail-header { padding: 28rpx 40rpx 24rpx; background-color: #FFFFFF; border-bottom: 1px solid #E8EBF0; }
	.back-button { display: flex; flex-direction: row; align-items: center; align-self: flex-start; }
	.back-icon { color: #F97316; font-size: 44rpx; line-height: 32rpx; }
	.back-text { margin-left: 4rpx; color: #F97316; font-size: 28rpx; font-weight: 500; }
	.header-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-top: 16rpx; }
	.header-eyebrow { font-size: 24rpx; font-weight: 600; }
	.header-title { margin-top: 4rpx; color: #111827; font-size: 36rpx; font-weight: 700; }
	.edit-button { padding: 12rpx 20rpx; border-width: 1px; border-style: solid; border-radius: 16rpx; }
	.edit-button-text { font-size: 24rpx; font-weight: 600; }
	.amount-banner { display: flex; flex-direction: row; align-items: center; padding: 36rpx 40rpx; border-bottom-width: 1px; border-bottom-style: solid; }
	.amount-icon { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; background-color: #FFFFFF; border-width: 1px; border-style: solid; border-radius: 24rpx; }
	.amount-copy { flex: 1; min-width: 0; margin-left: 24rpx; }
	.amount-label { color: #6B7280; font-size: 28rpx; font-weight: 600; }
	.amount-value { margin-top: 4rpx; font-size: 44rpx; font-weight: 700; }
	.rows-section { margin-top: 24rpx; padding: 0 40rpx; background-color: #FFFFFF; border-top: 1px solid #E8EBF0; border-bottom: 1px solid #E8EBF0; }
	.name-row { min-height: 112rpx; display: flex; flex-direction: row; align-items: center; justify-content: space-between; }
	.row-label { color: #9CA3AF; font-size: 24rpx; font-weight: 500; }
	.name-value { flex: 1; margin-left: 40rpx; color: #111827; font-size: 28rpx; font-weight: 600; text-align: right; }
	.muted-name { color: #9CA3AF; }
	.attachments-section { margin-top: 24rpx; padding: 30rpx 40rpx 40rpx; background-color: #FFFFFF; border-top: 1px solid #E8EBF0; border-bottom: 1px solid #E8EBF0; }
	.section-header { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
	.section-title { color: #111827; font-size: 28rpx; font-weight: 700; }
	.attachment-count { font-size: 24rpx; font-weight: 500; }
	.attachment-grid { display: flex; flex-direction: row; flex-wrap: wrap; margin: -8rpx; }
	.attachment-item { width: 200rpx; height: 200rpx; margin: 8rpx; overflow: hidden; background-color: #F0F2F5; border: 1px solid #E8EBF0; border-radius: 16rpx; }
	.attachment-image { width: 100%; height: 100%; }
	.empty-attachments { height: 160rpx; display: flex; align-items: center; justify-content: center; background-color: #F8F9FB; border: 1px dashed #D1D5DB; border-radius: 16rpx; }
	.empty-text { color: #9CA3AF; font-size: 24rpx; font-weight: 500; }
</style>
