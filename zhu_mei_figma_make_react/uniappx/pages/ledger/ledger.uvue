<template>
  <scroll-view class="page" scroll-y>
    <view class="topbar">
      <view>
        <text class="eyebrow">进出帐</text>
        <text class="page-title">收支记录</text>
      </view>
      <view class="add-button" @click="showLedgerForm = true">
        <text class="add-button-text">+ 新增</text>
      </view>
    </view>

    <view class="content">
      <view class="summary-row">
        <view class="summary-card income-summary">
          <text class="summary-label income-text">总收入</text>
          <text class="summary-value income-text">¥{{ toMoney(totalIncome) }}</text>
        </view>
        <view class="summary-card expense-summary">
          <text class="summary-label expense-text">总支出</text>
          <text class="summary-value expense-text">¥{{ toMoney(totalExpense) }}</text>
        </view>
      </view>

      <view class="filter-tabs">
        <view
          v-for="option in tabOptions"
          :key="option.value"
          :class="['filter-tab', tab == option.value ? 'filter-active' : '']"
          @click="tab = option.value"
        >
          <text :class="['filter-text', tab == option.value ? 'filter-active-text' : '']">
            {{ option.label }}
          </text>
        </view>
      </view>

      <view v-if="filteredEntries.length == 0" class="empty-list">
        <text class="empty-text">暂无收支记录</text>
      </view>
      <view v-for="entry in filteredEntries" :key="entry.id" class="entry-card">
        <view :class="['entry-icon', entry.type == 'income' ? 'income-icon' : 'expense-icon']">
          <text :class="entry.type == 'income' ? 'income-text' : 'expense-text'">
            {{ entry.type == "income" ? "↑" : "↓" }}
          </text>
        </view>
        <view class="entry-copy">
          <text class="entry-label">{{ entry.label }}</text>
          <text class="entry-meta">
            {{ entry.channel.length > 0 ? entry.channel : "未记录渠道" }} ·
            {{ formatShortDate(entry.date) }}
          </text>
        </view>
        <text :class="['entry-amount', entry.type == 'income' ? 'income-text' : 'expense-text']">
          {{ entry.type == "income" ? "+" : "-" }}¥{{ toMoney(entry.amount) }}
        </text>
        <view class="detail-button" @click="openDetail(entry)">
          <text class="detail-arrow">›</text>
        </view>
      </view>
    </view>

    <ledger-form-sheet
      v-if="showLedgerForm"
      mode="create"
      :initial-entry="null"
      @close="showLedgerForm = false"
      @save="saveLedger"
    />
  </scroll-view>
</template>

<script setup lang="uts">
import { addLedgerEntry, ledgerEntries, selectLedgerEntry } from "../../common/store.uts";
import { formatShortDate, toMoney } from "../../common/utils.uts";
import type { LedgerEntry } from "../../common/types.uts";

type TabOption = { value: string; label: string };
const tab = ref("all");
const showLedgerForm = ref(false);
const tabOptions: TabOption[] = [
  { value: "all", label: "全部" },
  { value: "income", label: "收入" },
  { value: "expense", label: "支出" }
];

const totalIncome = computed((): number => {
  let total = 0;
  ledgerEntries.value.forEach((entry) => {
    if (entry.type == "income") total += entry.amount;
  });
  return total;
});

const totalExpense = computed((): number => {
  let total = 0;
  ledgerEntries.value.forEach((entry) => {
    if (entry.type == "expense") total += entry.amount;
  });
  return total;
});

const filteredEntries = computed((): LedgerEntry[] => {
  if (tab.value == "all") return ledgerEntries.value;
  return ledgerEntries.value.filter((entry) => entry.type == tab.value);
});

function saveLedger(entry: LedgerEntry): void {
  addLedgerEntry(entry);
  showLedgerForm.value = false;
  uni.showToast({ title: "保存成功", icon: "success" });
}

function openDetail(entry: LedgerEntry): void {
  selectLedgerEntry(entry);
  uni.navigateTo({ url: "/pages/ledger-detail/ledger-detail" });
}
</script>

