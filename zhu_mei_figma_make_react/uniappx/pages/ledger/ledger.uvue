  color: #16a34a;
}

.expense-text {
  color: #e11d48;
}

.filter-tabs {
  display: flex;
  flex-direction: row;
  margin-top: 24rpx;
  padding: 8rpx;
  background-color: #f0f2f5;
  border-radius: 24rpx;
}

.filter-tab {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.filter-active {
  background-color: #ffffff;
}

.filter-text {
  color: #9ca3af;
  font-size: 24rpx;
  font-weight: 600;
}

.filter-active-text {
  color: #111827;
}

.entry-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 16rpx;
  padding: 26rpx 24rpx;
  background-color: #ffffff;
  border: 1px solid #e8ebf0;
  border-radius: 24rpx;
}

.entry-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-width: 1px;
  border-style: solid;
  border-radius: 22rpx;
}

.income-icon {
  background-color: #f0fdf4;
  border-color: #bbf7d0;
}

.expense-icon {
  background-color: #fff1f2;
  border-color: #fecdd3;
}

.entry-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.entry-label {
  color: #111827;
  font-size: 28rpx;
