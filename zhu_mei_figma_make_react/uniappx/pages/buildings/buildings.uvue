<template>
  <scroll-view class="page" scroll-y>
    <screen-header title="楼栋单元" subtitle="" />
    <view class="list">
      <view
        v-for="(building, index) in BUILDINGS"
        :key="building"
        class="building-card"
        @click="openFloors(building)"
      >
        <view class="card-main">
          <view class="index-box">
            <text class="index-text">{{ index + 1 }}</text>
          </view>
          <view class="building-copy">
            <text class="building-name">{{ building }}</text>
            <text class="building-meta">共 {{ 10 + index * 2 }} 层，已完工 0 层</text>
          </view>
        </view>
        <text class="chevron">›</text>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
import { BUILDINGS } from "../../common/data.uts";

function openFloors(building: string): void {
  uni.navigateTo({ url: `/pages/floors/floors?building=${encodeURIComponent(building)}` });
}
</script>

