# 使用变量
@port=7010


###
POST http://127.0.0.1:{{port}}/api/upload/multiple HTTP/1.1
Content-Type: multipart/form-data; boundary=fengefu

--fengefu
Content-Disposition: form-data; name="inputFile"; filename="gyy.jpeg"
Content-Type: image/jpeg

< ../imgs/gyy.jpeg

--fengefu
Content-Disposition: form-data; name="inputFile"; filename="present.png"
Content-Type: image/jpeg

< ../imgs/present.png
--fengefu--